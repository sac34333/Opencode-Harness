# ─── OpenCode / LLM Providers ────────────────────────────────────────────────
# Uncomment the provider(s) you use. OpenCode reads these automatically.

# Anthropic (Claude)
# ANTHROPIC_API_KEY=sk-ant-...

# OpenAI
# OPENAI_API_KEY=sk-...

# OpenRouter (multi-model routing)
# OPENROUTER_API_KEY=sk-or-...

# OpenCode Zen (opencode.ai hosted)
# OPENCODE_API_KEY=...

# ─── MCP Servers ─────────────────────────────────────────────────────────────

# GitHub MCP — Personal Access Token with: repo, read:org
# Create at: https://github.com/settings/tokens
GITHUB_TOKEN=ghp_your_token_here

# Supabase MCP — Management API token (not anon/service key)
# Create at: https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=sbp_your_token_here

# Cloudflare MCP — API Token with appropriate permissions
# Create at: https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_API_TOKEN=your_cloudflare_token_here
# Sign up at https://context7.com for higher rate limits
# CONTEXT7_API_KEY=

# ─── Backend (Skincare App) ───────────────────────────────────────────────────

# Supabase project connection
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Mem0 (open-source memory layer)
# Self-host or use managed: https://mem0.ai
MEM0_API_KEY=your_mem0_key_here

# Langfuse observability (free Cloud tier)
# Create at: https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=pk-lf-your_key_here
LANGFUSE_SECRET_KEY=sk-lf-your_key_here
LANGFUSE_HOST=https://cloud.langfuse.com

# OpenRouter (for LLM routing)
OPENROUTER_API_KEY=sk-or-your_key_here
